-        if (pendingOrderOut)
+        if (pendingOrderOut || (fixedSizeFullscreenActive && self.closing))
             [self doOrderOut];
+        else if (fixedSizeFullscreenActive)
+            /* Eligibility may have changed while entry was pending. */
+            [self adjustFullScreenBehavior:[self collectionBehavior]];
+    }
+
+    - (void) restoreNonFullscreenChildFrames
+    {
+        /* AppKit may move attached owned windows while centering/restoring a
+         * nonresizable fullscreen window. Restore their windowed positions too.
+         * Weak keys allow windows destroyed during fullscreen to disappear.
+         */
+        for (WineWindow* child in nonFullscreenChildFrames)
+        {
+            if (!child.closing && (child.parentWindow == self || child.latentParentWindow == self))
+            {
+                [child setFrameAndWineFrame:[[nonFullscreenChildFrames objectForKey:child] rectValue]];
+                [child windowDidResize:nil];
+            }
+        }
+        [nonFullscreenChildFrames release];
+        nonFullscreenChildFrames = nil;
+    }
+
+    /* AppKit can complete a transition after Win32 destroyed the window. Do
+     * not restore/display its frame in a late callback: that can resurrect a
+     * visible Cocoa shell without a Windows window behind it. */
+    - (BOOL) finishClosingFullscreenWindow
+    {
+        if (!fixedSizeFullscreenActive || !self.closing) return NO;
+        enteringFullScreen = exitingFullScreen = FALSE;
+        /* Retain the latch: another late callback must also avoid restoration. */
+        [nonFullscreenChildFrames release];
+        nonFullscreenChildFrames = nil;
+        [self doOrderOut];
+        return YES;
     }
 
     - (void) windowDidExitFullScreen:(NSNotification*)notification
     {
         exitingFullScreen = FALSE;
+        if ([self finishClosingFullscreenWindow]) return;
         [self setFrameAndWineFrame:nonFullscreenFrame];
         [self windowDidResize:nil];
+        [self restoreNonFullscreenChildFrames];
+        fixedSizeFullscreenActive = FALSE;
         if (pendingOrderOut)
             [self doOrderOut];
     }
